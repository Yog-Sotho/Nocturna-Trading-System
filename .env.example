# =============================================================================
# NOCTURNA Trading System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env.
# Every variable below is read by the app (src/config.py and the modules
# named in the comments) or by docker-compose.yml; nothing else is.
# =============================================================================

# =============================================================================
# SECURITY (required in production)
# =============================================================================

# Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
# 32+ characters; FLASK_SECRET_KEY and JWT_SECRET_KEY must differ.
FLASK_SECRET_KEY=your-flask-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
# Access token lifetime (1-24 hours). Refresh tokens last 7 days and are single use.
JWT_EXPIRATION_HOURS=1

# Secret mixed into API key hashes. Changing it invalidates every API key.
API_KEY_PEPPER=your-api-key-pepper-here

SECURE_COOKIES=true
SESSION_COOKIE_SAMESITE=Lax

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# IP allow/deny lists (comma-separated exact addresses; CIDR ranges are not supported).
# Whitelisted addresses skip rate limits and the failed-login lockout.
# IP_WHITELIST=192.168.1.1
# IP_BLACKLIST=192.168.1.100

# Number of reverse proxies (nginx, load balancer) in front of the app. Their
# X-Forwarded-For / X-Forwarded-Proto headers are trusted to find the client IP.
# Keep 0 when clients connect directly, or they could forge their address.
TRUSTED_PROXY_COUNT=0

# =============================================================================
# FLASK
# =============================================================================

FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# =============================================================================
# STORAGE
# =============================================================================

# PostgreSQL (required when FLASK_ENV=production; SQLite is used by default in development).
# postgresql:// URLs use the psycopg 3 driver. The schema is migrated at startup.
DATABASE_URL=postgresql://nocturna:your-db-password@postgres:5432/nocturna
# Used by docker-compose.yml for the postgres and redis containers
DB_PASSWORD=your-db-password
REDIS_PASSWORD=your-redis-password

# Rate-limit storage; without it limits are kept in process memory
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# TRADING (Alpaca paper account only)
# =============================================================================

# Live trading is disabled in code: the app refuses to start unless TRADING_MODE=PAPER
# and ALPACA_BASE_URL (if set) is the paper endpoint.
TRADING_MODE=PAPER
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Paper account keys (https://app.alpaca.markets/paper/dashboard/overview). Without
# them the API works but the engine cannot start. Market data uses the free plan.
ALPACA_API_KEY=your-alpaca-paper-api-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret-key

# Start the engine when the server starts (otherwise POST /api/trading/control/start)
ENGINE_AUTOSTART=false

# Risk limits, as fractions of account equity. Leverage is not configurable.
# Kill switch: at this drawdown from the equity high-water mark trading halts and,
# with RISK_FLATTEN_ON_KILL, every position is closed. POST /control/resume lifts
# the halt and restarts the high-water mark at the current equity.
RISK_MAX_DRAWDOWN=0.10
RISK_FLATTEN_ON_KILL=true
# After losing this much in one New York day, no new risk until the next day
RISK_DAILY_LOSS_LIMIT=0.03
RISK_MAX_POSITION_WEIGHT=0.6
RISK_MAX_CRYPTO_WEIGHT=0.15
# Largest single order in dollars (empty: no dollar cap; the weight caps still apply)
RISK_MAX_ORDER_NOTIONAL=
RISK_MAX_ORDERS_PER_DAY=50
# Position sizing: annualized volatility target (0 = off), drawdown where exposure
# starts shrinking (to zero at RISK_MAX_DRAWDOWN; 0 = off), and the rebalance band
SIZING_TARGET_VOLATILITY=0.08
SIZING_DERISK_START=0.05
SIZING_REBALANCE_BAND=0.02

# =============================================================================
# LOGGING (src/utils/logger.py)
# =============================================================================

LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_FILE=/app/logs/nocturna.log
AUDIT_LOG_FILE=/app/logs/audit.log

# =============================================================================
# GUNICORN (gunicorn.conf.py)
# =============================================================================

# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_THREADS=4
# GUNICORN_LOG_LEVEL=info

# =============================================================================
# OPERATOR ACCOUNT (read by `flask create-admin`)
# =============================================================================

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD is prompted for when not set
